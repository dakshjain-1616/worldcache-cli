# WorldCache CLI — Environment Variables
# Copy this file to .env and adjust values before running.
# Usage: cp .env.example .env

# ── Output ────────────────────────────────────────────────────────────
# Directory where WorldCache writes NPZ, JSON, and CSV outputs.
# Default: worldcache_output
WORLDCACHE_OUTPUT_DIR=worldcache_output

# ── Hash algorithm ────────────────────────────────────────────────────
# Perceptual hash algorithm used for temporal similarity detection.
# Options: dhash (difference hash), phash (perceptual/DCT hash), ahash (average hash)
# dhash is the fastest and best for temporal motion detection.
# Default: dhash
WORLDCACHE_ALGORITHM=dhash

# ── Similarity threshold ──────────────────────────────────────────────
# Frames with similarity >= this value are treated as cache hits.
# Range: 0.0 (always new anchor) to 1.0 (only identical frames are cached).
# Higher values → fewer cache hits but more accurate.
# Default: 0.92
WORLDCACHE_SIMILARITY_THRESHOLD=0.92

# ── Sliding window size ───────────────────────────────────────────────
# Number of recent anchor frames kept in the comparison window.
# Larger windows improve recall at the cost of O(window_size) comparisons per frame.
# Default: 32
WORLDCACHE_WINDOW_SIZE=32

# ── Hash grid size ────────────────────────────────────────────────────
# Hash length = WORLDCACHE_HASH_SIZE². Larger values are more discriminative
# but slower to compute. Recommended range: 8–32.
# Default: 16
WORLDCACHE_HASH_SIZE=16

# ── Frame limit ───────────────────────────────────────────────────────
# Maximum number of frames to process per video (0 = unlimited).
# Useful for quick tests on large videos.
# Default: 0 (unlimited)
WORLDCACHE_MAX_FRAMES=0
